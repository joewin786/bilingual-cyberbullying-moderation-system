# ============================================================
# .env.example — Cyberbullying Detection System
# Salin file ini ke .env dan isi semua variabel
# ============================================================

# ── Discord Bot ──────────────────────────────────────────────
# Token bot dari Discord Developer Portal
# https://discord.com/developers/applications
DISCORD_TOKEN=masukkan_token_bot_discord_kamu_disini

# ID server Discord kamu (klik kanan server → Copy Server ID)
GUILD_ID=123456789012345678

# ID channel untuk log moderasi (klik kanan channel → Copy Channel ID)
MOD_CHANNEL_ID=123456789012345678

# ID role untuk mute (buat role "Muted" di server → Copy Role ID)
MUTE_ROLE_ID=123456789012345678

# ── n8n Webhook ──────────────────────────────────────────────
# URL webhook n8n (setelah import workflow_cyberbully.json)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/cyberbully

# ── FastAPI Inference Server ─────────────────────────────────
API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# ── Model ────────────────────────────────────────────────────
# Path ke model yang sudah di-fine-tune
MODEL_PATH=models/xlmr_cyberbully

# ── Confidence Thresholds ────────────────────────────────────
# < CONFIDENCE_FLAG      → ignore (bukan bully)
# CONFIDENCE_FLAG–CONFIDENCE_ACTION → flag (review manual moderator)
# > CONFIDENCE_ACTION    → aksi otomatis (warn/mute/kick)
CONFIDENCE_FLAG=0.70
CONFIDENCE_ACTION=0.85

# ── Moderasi ─────────────────────────────────────────────────
# Durasi mute dalam jam (Tahap 2)
MUTE_DURATION_HOURS=8

# Hari sebelum violation count direset (jika tidak ada pelanggaran baru)
VIOLATION_RESET_DAYS=30

# ── PostgreSQL Database ──────────────────────────────────────
# Host dan port PostgreSQL (localhost jika bot dijalankan lokal di luar docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyberbully_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cyberbully_secure_pwd

